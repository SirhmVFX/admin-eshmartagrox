rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for site content (storefront)
    match /config/siteContent {
      allow read: if true;
      allow write: if false;
    }

    // Roles: admins only (via custom claims or check admins collection in app)
    match /roles/{roleId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Deny direct client writes — admin panel uses API + Admin SDK
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
